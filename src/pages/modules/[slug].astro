---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import Flow from '../../components/Flow.astro';
import BrokenFixedFlow from '../../components/BrokenFixedFlow.astro';
import Scrolly from '../../components/Scrolly.astro';
import Step from '../../components/Step.astro';
import RfcQuote from '../../components/RfcQuote.astro';
import Note from '../../components/Note.astro';
import Mistakes from '../../components/Mistakes.astro';
import Mistake from '../../components/Mistake.astro';
import Term from '../../components/Term.astro';
import Stats from '../../components/Stats.astro';
import Stat from '../../components/Stat.astro';
import Digest from '../../components/Digest.astro';
import CallPlayer from '../../components/CallPlayer.astro';
import TwoPaths from '../../components/TwoPaths.astro';
import ProtocolStack from '../../components/ProtocolStack.astro';
import ColourKey from '../../components/ColourKey.astro';
import CircuitVsPacket from '../../components/CircuitVsPacket.astro';
import ProtocolCompare from '../../components/ProtocolCompare.astro';
import HttpVsSip from '../../components/HttpVsSip.astro';
import RfcMap from '../../components/RfcMap.astro';
import Landscape from '../../components/Landscape.astro';
import AddressClassifier from '../../components/AddressClassifier.astro';
import CompareFlows from '../../components/CompareFlows.astro';
import NatRewrite from '../../components/NatRewrite.astro';
import PacketExplorer from '../../components/PacketExplorer.astro';
import UriDissector from '../../components/UriDissector.astro';
import ElementGallery from '../../components/ElementGallery.astro';
import LocationService from '../../components/LocationService.astro';
import MessageAnatomy from '../../components/MessageAnatomy.astro';
import FramingLab from '../../components/FramingLab.astro';
import MethodCards from '../../components/MethodCards.astro';
import CapabilityLab from '../../components/CapabilityLab.astro';
import CodeAtlas from '../../components/CodeAtlas.astro';
import HeaderReference from '../../components/HeaderReference.astro';
import HeaderJourney from '../../components/HeaderJourney.astro';
import TransactionPlayer from '../../components/TransactionPlayer.astro';
import TimerTimeline from '../../components/TimerTimeline.astro';
import TransactionMatcher from '../../components/TransactionMatcher.astro';
import DialogTable from '../../components/DialogTable.astro';
import ForkingTree from '../../components/ForkingTree.astro';
import RoutingLab from '../../components/RoutingLab.astro';
import ViaStack from '../../components/ViaStack.astro';
import DnsResolver from '../../components/DnsResolver.astro';
import RegistrarView from '../../components/RegistrarView.astro';
import ExpiryClock from '../../components/ExpiryClock.astro';
import AttackMap from '../../components/AttackMap.astro';
import CertCheck from '../../components/CertCheck.astro';
import OfferAnswer from '../../components/OfferAnswer.astro';
import SdpLinter from '../../components/SdpLinter.astro';
import HoldPlayer from '../../components/HoldPlayer.astro';
import { LEVEL_LABEL, OUTLINE, pad2 } from '../../lib/outline.ts';
import { url } from '../../lib/url.ts';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const part = OUTLINE.find(p => p.n === d.part)!;

// Previous / next live modules
const all = (await getCollection('modules')).sort((a, b) => a.data.module - b.data.module);
const i = all.findIndex(m => m.id === entry.id);
const prev = all[i - 1];
const next = all[i + 1];
const flat = OUTLINE.flatMap(p => p.modules);
const nextPlanned = flat.find(m => m.n === d.module + 1);

const components = { Flow, BrokenFixedFlow, Scrolly, Step, RfcQuote, Note, Mistakes, Mistake, Term, Stats, Stat, Digest, CallPlayer, TwoPaths, ProtocolStack, ColourKey,
  CircuitVsPacket, ProtocolCompare, HttpVsSip, RfcMap, Landscape,
  AddressClassifier, CompareFlows, NatRewrite, PacketExplorer,
  UriDissector, ElementGallery, LocationService, MessageAnatomy, FramingLab,
  MethodCards, CapabilityLab, CodeAtlas,
  HeaderReference, HeaderJourney,
  TransactionPlayer, TimerTimeline, TransactionMatcher,
  DialogTable, ForkingTree,
  RoutingLab, ViaStack,
  DnsResolver,
  RegistrarView, ExpiryClock,
  AttackMap, CertCheck, OfferAnswer, SdpLinter, HoldPlayer };
---
<Base title={`${pad2(d.module)} ${d.title}`} description={d.summary} withSidebar>
  <div class="shell">
    <Sidebar current={d.module} />
    <main class="main" id="content">
      <header class="mod-head">
        <p class="crumbs">Part {part.n} · {part.title} / <b>Module {pad2(d.module)}</b></p>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <div class="badges">
          {d.level.map(l => <span class="badge">{LEVEL_LABEL[l]}</span>)}
          <span class={`badge ${d.paths.noc}`}>NOC {d.paths.noc}</span>
          <span class={`badge ${d.paths.dev}`}>DEV {d.paths.dev}</span>
          {d.status !== 'published' && <span class="badge draft">{d.status}</span>}
        </div>
        <section class="objectives" aria-label="Objectives">
          <p class="eyebrow">After this module, you can</p>
          <ul>{d.objectives.map(o => <li>{o}</li>)}</ul>
        </section>
      </header>

      <article class="prose">
        <Content components={components} />
      </article>

      <nav class="mod-foot" aria-label="Module navigation">
        {prev && <a href={url(`modules/${prev.id}/`)}><small>← Module {pad2(prev.data.module)}</small><span>{prev.data.title}</span></a>}
        {next
          ? <a class="next" href={url(`modules/${next.id}/`)}><small>Module {pad2(next.data.module)} →</small><span>{next.data.title}</span></a>
          : nextPlanned && <a class="next soon" aria-disabled="true"><small>Module {pad2(nextPlanned.n)} · coming soon</small><span>{nextPlanned.title}</span></a>}
      </nav>
    </main>
  </div>
</Base>
