---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/martian-mono/400.css';
import '@fontsource/martian-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';
import '../styles/diagram.css';
import BrandMark from '../components/BrandMark.astro';
import SiteSearch from '../diagrams/SiteSearch.tsx';
import { url } from '../lib/url.ts';

interface Props {
  title: string;
  description: string;
  /** Show the course sidebar toggle in the header */
  withSidebar?: boolean;
}
const { title, description, withSidebar = false } = Astro.props;
const pageTitle = title === 'SIP Mastery' ? title : `${title} · SIP Mastery`;
const path = Astro.url.pathname;
const repoUrl = import.meta.env.PUBLIC_REPO_URL as string | undefined;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F5F0" />
    <script is:inline>
      // Apply the saved theme before the first paint. Light is the default.
      try {
        if (localStorage.getItem('theme') === 'dark') {
          delete document.documentElement.dataset.theme;
          document.querySelector('meta[name=theme-color]').content = '#0E1013';
        }
      } catch {}
    </script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <a class="sr-only" href="#content">Skip to content</a>
    <div class="nav-loader" aria-hidden="true"><div class="nav-bar"></div><div class="nav-chip"><span class="nav-spin"></span>Loading…</div></div>
    <header class="site-head">
      <a class="brand" href={url()}><BrandMark />SIP <em>Mastery</em></a>
      <div class="head-tools">
        <nav class="site-nav" aria-label="Site">
          <a href={url()} aria-current={path === url() || path === url().replace(/\/$/, '') ? 'page' : undefined}>Course map</a>
          {repoUrl && <a href={repoUrl} rel="noopener">Source</a>}
        </nav>
        <SiteSearch client:idle />
        <button class="theme-btn" type="button" id="theme-btn" aria-label="Switch to dark theme" title="Switch to dark theme">
          <svg class="i-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.2v1.8M8 13v1.8M1.2 8H3M13 8h1.8M3.2 3.2l1.3 1.3M11.5 11.5l1.3 1.3M3.2 12.8l1.3-1.3M11.5 4.5l1.3-1.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          <svg class="i-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M13.5 9.8A5.8 5.8 0 0 1 6.2 2.5a5.8 5.8 0 1 0 7.3 7.3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
        </button>
        {withSidebar && <button class="menu-btn" type="button" aria-expanded="false" aria-controls="sidebar" id="menu-btn">Modules</button>}
      </div>
    </header>
    <slot />
    <footer class="site-foot">
      <p>SIP Mastery is free and open source. Course text and diagrams: <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a>. Code: MIT.</p>
      <p>RFC excerpts are quoted from IETF documents under the IETF Trust Legal Provisions, with links to <a href="https://www.rfc-editor.org/" rel="noopener">rfc-editor.org</a>.</p>
    </footer>
    <script>
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-btn')!;
      const showTheme = () => {
        const label = root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme';
        themeBtn.setAttribute('aria-label', label);
        themeBtn.title = label;
        document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!.content = root.dataset.theme === 'light' ? '#F7F5F0' : '#0E1013';
      };
      showTheme();
      themeBtn.addEventListener('click', () => {
        const light = root.dataset.theme !== 'light';
        if (light) root.dataset.theme = 'light';
        else delete root.dataset.theme;
        try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch {}
        showTheme();
      });

      // Page loader: some module pages are large, so show that the next page is on its way.
      // The bar and chip appear only if the page takes more than a moment (CSS delays).
      let navTimer: number | undefined;
      const startNav = () => {
        root.classList.add('is-navigating');
        clearTimeout(navTimer);
        navTimer = window.setTimeout(() => root.classList.remove('is-navigating'), 20000);
      };
      document.addEventListener('click', e => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
        const to = new URL(a.href, location.href);
        if (!/^https?:$/.test(to.protocol)) return;
        if (to.pathname === location.pathname && to.search === location.search) return; // same page or #anchor
        startNav();
      });
      document.addEventListener('sip:navigate', startNav);
      // Back/forward from the page cache: the old page comes back, so hide the loader
      window.addEventListener('pageshow', () => root.classList.remove('is-navigating'));

      const btn = document.getElementById('menu-btn');
      btn?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
