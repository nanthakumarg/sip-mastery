---
/** <RoutingLab /> : Record-Route and lr for each proxy, and the path of later requests (Module 10.4) */
import Island from '../diagrams/RoutingLab.tsx';
import { clientRefData, quoteMap } from '../lib/bundle.ts';
import { trapezoidCall, trapezoidOptions } from '../sip/routing.ts';

// Every quote that any combination of the visualiser can show.
const ids = new Set<string>();
for (const o of trapezoidOptions()) for (const s of trapezoidCall(o).flow.steps) if (s.rfc) ids.add(s.rfc);
---
<div class="wide"><Island client:visible quotes={quoteMap([...ids])} refData={clientRefData()} /></div>
