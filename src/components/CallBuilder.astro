---
/** <CallBuilder preset={{ path: 'direct' }} /> : the call flow builder, starting from one combination. */
import CallBuilder from '../diagrams/CallBuilder.tsx';
import { toClientFlow } from '../diagrams/client-flow.ts';
import { clientRefData, quoteMap } from '../lib/bundle.ts';
import { applyChange, buildCall, DEFAULT_CALL, type CallOptions } from '../sip/callflow.ts';
import { prepareFlow } from '../sip/flow.ts';

interface Props { preset?: Partial<CallOptions>; eyebrow?: string }
const { preset = {}, eyebrow } = Astro.props;
const { options, notes } = applyChange({ ...DEFAULT_CALL, ...preset }, {});
if (notes.length) throw new Error(`CallBuilder preset ${JSON.stringify(preset)} is not a valid combination: ${notes.join(' ')}`);
const flow = toClientFlow(await prepareFlow(buildCall(options)));

// Only what the first flow needs; the island loads the rest from /call-builder.json.
const ref = clientRefData();
const wires = flow.steps.map(s => s.wire ?? '').join('');
const refData = { ...ref, headers: Object.fromEntries(Object.entries(ref.headers).filter(([name]) => wires.includes(`\r\n${name}:`))) };
const quotes = quoteMap([...new Set(flow.steps.flatMap(s => (s.rfc ? [s.rfc] : [])))]);
---
<div class="wide">
  <CallBuilder client:visible options={options} flow={flow} quotes={quotes} refData={refData} eyebrow={eyebrow} />
</div>
