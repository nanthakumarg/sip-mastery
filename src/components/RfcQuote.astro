---
/** <RfcQuote id="rfc3261-22.2-cseq-increment" /> : exact quote, verified by npm run verify:rfc */
import { quoteById, rfcUrl } from '../lib/data.ts';
import { isNumberedSection } from '../lib/rfc-ref.ts';

interface Props { id: string }
const q = quoteById(Astro.props.id);
const KW = /\b(MUST NOT|MUST|SHALL NOT|SHALL|SHOULD NOT|SHOULD|NOT RECOMMENDED|RECOMMENDED|MAY|REQUIRED|OPTIONAL)\b/;
const parts = q.text.replace(/\s+/g, ' ').split(KW);
---
<figure class="rfcq">
  <figcaption class="src"><b>RFC {q.rfc}{isNumberedSection(q.section) && ` §${q.section}`}</b> · {q.title}</figcaption>
  <blockquote cite={rfcUrl(q.rfc, q.section)}>
    “{parts.map((p, i) => (i % 2 ? <strong class="kw">{p}</strong> : p))}”
  </blockquote>
  <a href={rfcUrl(q.rfc, q.section)} rel="noopener">Read the section ↗</a>
</figure>
